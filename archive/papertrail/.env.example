# 환경 변수 예시 파일
# 실제 운영 환경에서는 .env 파일을 생성하고 값을 설정합니다.

# Azure 구독 설정
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure 리소스 이름 접두사 (자동 생성)
SCHOOL_NAME_TOKEN=
NICE_CODE=
SCHOOL_LEVEL=
ENV_SHORT=
DEPLOY_NUM=

# 위치 및 지역
LOCATION=koreacentral
REGION_CODE=krc

# Bicep 템플릿 파일 경로
TEMPLATE_FILE=infra/main.subscription.bicep

# 배포 모드
ALLOW_DEFAULT_SECRETS=false
DEPLOY_WHAT_IF=0
NON_INTERACTIVE=0

# Azure OpenAI 설정 (필요시)
AZURE_OPENAI_ENDPOINT=
API_KEY_AI=

# Azure Storage 연결 문자열 (로컬 개발용)
AZURE_STORAGE_CONNECTION_STRING=

# Cosmos DB 연결 문자열
COSMOS_CONNECTION_STRING=

# Log Analytics 작업 영역 ID 및 키
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_SHARED_KEY=

# 외부 API 키
NEWS_API_KEY=

# 기타
HEALTH_WEBHOOK_URL=