# neIS API
NEIS_API_KEY=your_key_here

# 경로
DATA_ROOT=./data
LOG_DIR=./data/logs

# Notifier (Phase 3에서 사용)
NOTIFIER_ENABLED=false
NOTIFIER_URL=http://localhost:8001
NOTIFIER_API_KEY=notifier_secret

# HTTP 클라이언트
HTTP_TIMEOUT=20
HTTP_MAX_RETRIES=3
HTTP_RATE_PER_SEC=5
HTTP_BURST=5

# 로깅 (선택)
LOG_LEVEL=INFO
LOG_FORMAT=json

# FastAPI 서버
API_HOST=127.0.0.1
API_PORT=8000
